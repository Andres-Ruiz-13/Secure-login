{
  "info": {
    "name": "INBOT SYSTEM - API REST & CMS",
    "description": "Colección completa de pruebas para INBOT System (Inventarios, Facturación, Chatbot aHash, Seguridad RBAC y CMS)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Autenticación (Sanctum)",
      "item": [
        {
          "name": "T01 - Registro Válido (201)",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Operador Prueba\",\n  \"email\": \"operador@inbot.com\",\n  \"password\": \"Segura123!\",\n  \"password_confirmation\": \"Segura123!\"\n}"},
            "url": {"raw": "{{base_url}}/api/register", "host": ["{{base_url}}"], "path": ["api", "register"]}
          }
        },
        {
          "name": "T06 - Login Administrador (200)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var jsonData = pm.response.json();",
                "if (jsonData.token) { pm.environment.set('token_admin', jsonData.token); }"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@inbot.com\",\n  \"password\": \"Segura123!\"\n}"},
            "url": {"raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"]}
          }
        },
        {
          "name": "T06B - Login Vendedor (200)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var jsonData = pm.response.json();",
                "if (jsonData.token) { pm.environment.set('token_vendedor', jsonData.token); }"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"vendedor@inbot.com\",\n  \"password\": \"Segura123!\"\n}"},
            "url": {"raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"]}
          }
        },
        {
          "name": "T07 - Login Credenciales Inválidas (401)",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@inbot.com\",\n  \"password\": \"ClaveErronea123\"\n}"},
            "url": {"raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"]}
          }
        },
        {
          "name": "T11 - Perfil Autenticado (200)",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_admin}}"}],
            "url": {"raw": "{{base_url}}/api/profile", "host": ["{{base_url}}"], "path": ["api", "profile"]}
          }
        },
        {
          "name": "T12 - Logout y Revocación de Token (200)",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_admin}}"}],
            "url": {"raw": "{{base_url}}/api/logout", "host": ["{{base_url}}"], "path": ["api", "logout"]}
          }
        }
      ]
    },
    {
      "name": "02 Productos e Inventario (Módulo A)",
      "item": [
        {
          "name": "Listar Productos Paginados (200)",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_admin}}"}],
            "url": {"raw": "{{base_url}}/api/productos?per_page=15", "host": ["{{base_url}}"], "path": ["api", "productos"], "query": [{"key": "per_page", "value": "15"}]}
          }
        },
        {
          "name": "Endpoint Stock Bajo (200)",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token_admin}}"}],
