            "body": {"mode": "raw", "raw": "{\n  \"codigo_barras\": \"7701234999999\",\n  \"nombre\": \"Cinta Metrica 5 Metros Pro\",\n  \"categoria_id\": 1,\n  \"proveedor_id\": 1,\n  \"stock_actual\": 25,\n  \"stock_minimo\": 5,\n  \"precio_compra\": 12000,\n  \"porcentaje_ganancia\": 35\n}"},
            "url": {"raw": "{{base_url}}/api/productos", "host": ["{{base_url}}"], "path": ["api", "productos"]}
          }
        }
      ]
