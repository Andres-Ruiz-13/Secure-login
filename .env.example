APP_NAME=INBOT_SYSTEM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos local (MySQL/MariaDB de XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inbot_system
DB_USERNAME=root
DB_PASSWORD=

# En la nube (Render / Supabase / Neon): descomentar DB_URL con URL de conexión PostgreSQL
# DB_URL=postgresql://user:password@host:port/database
# DB_CONNECTION=pgsql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="administracion@empresa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Configuración comercial INBOT System
INBOT_ROUNDING_MODE=50
INBOT_DEFAULT_PROFIT=30.0
INBOT_LOW_STOCK_THRESHOLD=5
INBOT_AHASH_MAX_DISTANCE=10

VITE_APP_NAME="${APP_NAME}"
